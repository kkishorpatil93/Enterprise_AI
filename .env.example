# NEXORA AI - Environment Variables
# Copy to .env.local for local development. Never commit .env.local to version control.

# Supabase (Public Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (Server Only - Never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API (Server Only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# NEXORA Host Agent Authentication Salt
AGENT_TOKEN_SALT=nexora_agent_secret_salt_2026

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

